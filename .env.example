APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_PASSWORD=
MAX_REQUEST_BYTES=1048576
MAX_RESPONSE_BYTES=10485760

BEDROCK_API_KEY=

LOG_LEVEL=INFO
LOG_BODIES=true
LOG_BODY_MAX_CHARS=8000

AUDIT_BODY_MAX_CHARS=65536

# Admin API (/api/v1) — Supabase Auth
SUPABASE_URL=
SUPABASE_JWT_SECRET=
ADMIN_AUTH_DISABLED=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# TypeSafe Jev specialist (optional; omit → NullScorer / rules-only)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=0.8
